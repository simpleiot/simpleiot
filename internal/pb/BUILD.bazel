load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")

# Re-enable proto rule generation here (disabled globally in the root
# BUILD.bazel). Gazelle emits proto_library + go_proto_library and wires the
# go_library to embed the generated bindings.
# gazelle:proto default
# gazelle:go_generate_proto true
#
# The .proto files import each other by basename (e.g. import "point.proto")
# relative to --proto_path=internal/pb. Strip that prefix so Bazel proto import
# paths match, instead of being repo-root-relative.
# gazelle:proto_strip_import_prefix /internal/pb

proto_library(
    name = "pb_proto",
    srcs = [
        "file-chunk.proto",
        "message.proto",
        "node.proto",
        "notification.proto",
        "point.proto",
    ],
    strip_import_prefix = "/internal/pb",
    visibility = ["//:__subpackages__"],
    deps = ["@protobuf//:timestamp_proto"],
)

go_proto_library(
    name = "pb_go_proto",
    importpath = "github.com/simpleiot/simpleiot/internal/pb",
    proto = ":pb_proto",
    visibility = ["//:__subpackages__"],
)

go_library(
    name = "pb",
    embed = [":pb_go_proto"],
    importpath = "github.com/simpleiot/simpleiot/internal/pb",
    visibility = ["//:__subpackages__"],
)
