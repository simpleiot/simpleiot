{
	"name": "siot-ui",
	"version": "0.0.0",
	"private": true,
	"description": "Simple IoT admin UI",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && svelte-check --fail-on-warnings && vite build",
		"check": "svelte-kit sync && svelte-check --fail-on-warnings",
		"lint": "prettier --plugin prettier-plugin-svelte --check . && eslint .",
		"format": "prettier --plugin prettier-plugin-svelte --write .",
		"test": "vitest run",
		"postinstall": "node -e \"require('fs').writeFileSync('node_modules/go.mod', 'module ignore\\n')\""
	},
	"license": "Apache-2.0",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.61.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"simpleiot-js": "file:../frontend/lib",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "~6.0",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	}
}
