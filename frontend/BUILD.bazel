load("@rules_go//go:def.bzl", "go_library", "go_test")

# Build the Elm SPA into a gzipped elm.js. The Elm sources are declared inputs,
# so editing them rebuilds this output and, transitively, anything that embeds
# it. The output path matches what embed.go's `//go:embed public/*` expects.
genrule(
    name = "elm_js_gz",
    srcs = glob([
        "src/**",
    ]) + [
        "elm.json",
        "elm-tooling.json",
        "package.json",
        "package-lock.json",
    ],
    outs = ["public/dist/elm.js.gz"],
    cmd = "bash $(location //bazel:build_frontend.sh) $$(dirname $(location elm.json)) $@",
    # Non-hermetic: runs host node/npm/elm and may fetch npm packages.
    local = True,
    tags = ["requires-network"],
    tools = ["//bazel:build_frontend.sh"],
)

go_library(
    name = "frontend",
    srcs = [
        "doc.go",
        "embed.go",
    ],
    embedsrcs = [
        "public/ble.js",
        "public/dist/elm.js.gz",  # keep - generated by :elm_js_gz
        "public/favicon.png",
        "public/index.html",
        "public/main.js",
        "public/simple-iot-app-logo.png",
        "public/styles.css",
    ],
    importpath = "github.com/simpleiot/simpleiot/frontend",
    visibility = ["//visibility:public"],
)

go_test(
    name = "frontend_test",
    srcs = ["embed_test.go"],
    embed = [":frontend"],
)
