"""Simple IoT - Bazel module definition.

Uses rules_go + Gazelle. Go dependencies are sourced directly from go.mod,
so go.mod/go.sum remain the single source of truth for versions.

After changing dependencies or BUILD files, run `bazel mod tidy` to keep the
use_repo block below in sync with what the build actually references.
"""

module(
    name = "simpleiot",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.61.1")
bazel_dep(name = "gazelle", version = "0.51.3")

# Provides proto_library + protoc for compiling internal/pb/*.proto. This makes
# editing a .proto regenerate the Go bindings as part of the build graph, rather
# than relying on the out-of-band `siot_protobuf` step.
bazel_dep(name = "protobuf", version = "33.6")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.24.12")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_adrianmo_go_nmea", "com_github_beevik_ntp", "com_github_blang_semver_v4", "com_github_cavaliercoder_grab", "com_github_cosmtrek_air", "com_github_dim13_cobs", "com_github_donovanhide_eventsource", "com_github_fsnotify_fsnotify", "com_github_go_audio_wav", "com_github_goccy_go_yaml", "com_github_godbus_dbus_v5", "com_github_golang_jwt_jwt_v4", "com_github_golang_protobuf", "com_github_google_go_cmp", "com_github_google_uuid", "com_github_influxdata_influxdb_client_go_v2", "com_github_jacobsa_go_serial", "com_github_kevinburke_twilio_go", "com_github_kjx98_crc16", "com_github_koding_websocketproxy", "com_github_nats_io_nats_go", "com_github_nats_io_nats_server_v2", "com_github_oklog_run", "com_github_pkg_errors", "com_github_shirou_gopsutil_v3", "com_github_simpleiot_canparse", "com_github_simpleiot_mdns", "com_github_wifx_gonetworkmanager_v2", "org_golang_google_protobuf", "org_golang_x_exp", "org_golang_x_lint", "org_modernc_sqlite", "st_bug_go_serial", "tech_einride_go_can")
